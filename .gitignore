/reference/

/build/

# Absolute path to the MafiaHub Framework checkout, written by scripts/setup.bat.
/.framework-root
__pycache__/

# Generated next to the source if embed_ui.py is run without -o.
# CMake writes the real header into the build tree.
/code/client/src/core/ui/generated/

# Last vite-plugin-singlefile page. Rebuilds rewrite the whole file;
# the client embeds ui/dist or this copy locally, not from git.
/data/ui/index.html

# Launcher runtime artifacts
*_launcher.json
/logs/
/cache/

# Local crash reports and minidumps, written beside the client at runtime.
crashes/
*.dmp

# Exported chat transcripts. Session artefacts, not project content.
.ai/*history*.txt

# EOS SDK: keep Bin/Lib/Include/HostModules; skip huge Tools archives and
# the integrity private key (never commit base_private.key).
/vendors/eos/Tools/
/vendors/eos/Keys/base_private.key
