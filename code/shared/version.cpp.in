#include "shared/version.h"

#include <cstdio>

#define VANTAMP_GIT_VERSION_LONG "@VANTAMP_GIT_VERSION_LONG@"
#define VANTAMP_GIT_VERSION      "@VANTAMP_GIT_VERSION@"
#define VANTAMP_VERSION          "@VANTAMP_VERSION@"
#define VANTAMP_GIT_BRANCH       "@VANTAMP_GIT_BRANCH@"
#define VANTAMP_ENVIRONMENT      "@VANTAMP_ENVIRONMENT@"

namespace VantaMP::Version {
    const char *git         = VANTAMP_GIT_VERSION;
    const char *gitLong     = VANTAMP_GIT_VERSION_LONG;
    const char *rel         = VANTAMP_VERSION;
    const char *branch      = VANTAMP_GIT_BRANCH;
    const char *environment = VANTAMP_ENVIRONMENT;

    const char *Label() {
        static char buffer[192];
        static bool ready = false;

        if (!ready) {
            std::snprintf(buffer, sizeof(buffer), "%s %s (%s)", rel, environment, branch);
            ready = true;
        }

        return buffer;
    }
};
