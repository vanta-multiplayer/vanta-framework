# Public identity host (Epic UserInfo + clients).
VANTA_AUTH_PUBLIC_URL=https://id.vantamp.xyz

# Bind inside the auth container (compose overrides host to 0.0.0.0).
VANTA_AUTH_HOST=0.0.0.0
VANTA_AUTH_PORT=28080

# Generated by: bun run secrets:gen
POSTGRES_USER=vanta
POSTGRES_PASSWORD=CHANGE_ME_RUN_secrets_gen
POSTGRES_DB=vanta_auth

# Host-side tooling (drizzle studio / local bun). Compose overrides these for the auth container.
DATABASE_URL=postgres://vanta:CHANGE_ME_RUN_secrets_gen@127.0.0.1:5432/vanta_auth
REDIS_PASSWORD=CHANGE_ME_RUN_secrets_gen
REDIS_URL=redis://:CHANGE_ME_RUN_secrets_gen@127.0.0.1:6379/0

ACCESS_TOKEN_TTL_SECONDS=600
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REGISTER=20
RATE_LIMIT_MAX_TOKEN=60

# Let's Encrypt HTTP-01 (bun run certs:http)
CERTBOT_EMAIL=admin@vantamp.xyz
CERTBOT_DOMAIN=id.vantamp.xyz

# Optional Cloudflare Tunnel (fixes 522 when inbound 443 is blocked; keeps orange cloud).
# CLOUDFLARE_TUNNEL_TOKEN=
